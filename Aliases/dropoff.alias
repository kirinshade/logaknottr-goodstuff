embed <drac2>
def process_and_delete_bags():
    tallies = {}
    bags_to_keep = []
    for bag in bags:
        bagname, bag_contents = bag[0], bag[1]
        if bagname in target_bags:
            tallies.update({bagname: sum(bag_contents.values())})
        else:
            bags_to_keep.append(bag)
        
    character().set_cvar("bags", dump_json(bags_to_keep))
    return tallies

def reward_gold(tallies):
    r_total = 0
    for key in tallies:
        r_total += tallies.get(key)
    gold = {
        "silver": r_total % 10, 
        "gold": r_total // 10, 
        "glc": min(r_total//100, 3)
        }
    character().coinpurse.modify_coins(0, gold.get("gold"), 0, gold.get("silver"))
    return gold    

def format_output(tallies, gold):
    output = "The following quantities have been added to your scavenging bags: \n"
    if not tallies:
        output += "__Total__: 0 \n"
    else:
        r_total = 0
        for key in tallies:
            output += str(key) + ": " + str(tallies.get(key)) + " \n"
            r_total += tallies.get(key)
        output += "__Total__: " + r_total + " \n"
    output += f"""As a result, you have automagically gained {gold.get("gold")} gold and {gold.get("silver")} silver. \n \n You may now manually add {gold.get("glc")} Gold Leaf Coins using your method of choice"""
    return output

bags = load_json(character().get_cvar("bags", "[]"))
target_bags = ["Fish", "Forage", "Meat"]
tallies = process_and_delete_bags()
gold = reward_gold(tallies)
output = format_output(tallies, gold)
</drac2>

-title "{{character().name}} sells their goods"
-desc "{{output}}"
-footer "{{ctx.prefix + ctx.alias}}"
